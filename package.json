{
  "name": "skematron",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable control plane for database schemas and migrations.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "typecheck": "tsc && pnpm --filter @skematron/web typecheck",
    "test": "node --env-file-if-exists=.env --test \"packages/*/src/**/*.test.ts\" \"apps/*/lib/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "web": "pnpm --filter @skematron/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "sh scripts/local-postgres.sh start",
    "db:seed": "sh scripts/local-postgres.sh seed",
    "db:stop": "sh scripts/local-postgres.sh stop",
    "db:test:start": "sh scripts/local-postgres.sh start",
    "db:test:seed": "sh scripts/local-postgres.sh seed",
    "db:test:stop": "sh scripts/local-postgres.sh stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "example:export": "node --env-file-if-exists=.env packages/adapters/examples/export-schema.ts",
    "sync:ai": "node scripts/sync-ai.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check": "pnpm typecheck && pnpm format:check && pnpm test && pnpm check:docs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
