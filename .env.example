# .env is git-ignored and used only by the PostgreSQL integration tests.
# `pnpm db:test:start` starts a disposable local cluster and writes this file for you.
# Or point it at any dedicated, disposable PostgreSQL 14+ database. Tests create and drop
# their own skematron_test_* schemas inside it and never touch anything else.
SKEMATRON_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/skematron_test
