# .env is git-ignored. For local development, `pnpm db:start` starts a disposable PostgreSQL
# cluster and adds any missing keys below for you (with freshly generated secrets).
# For self-hosting, see docs/self-hosting.md.

# Skematron's own metadata database (never a user's application database).
SKEMATRON_DATABASE_URL=postgresql://skematron:password@localhost:5432/skematron

# Encrypts stored database connection URLs. Base64 of 32 random bytes: openssl rand -base64 32
# Back it up with the database: without it, stored connections cannot be decrypted.
SKEMATRON_SECRET_KEY=replace-with-openssl-rand-base64-32

# Signs sessions. Base64 random value: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# The URL people use to reach the dashboard (also used for invitation links).
BETTER_AUTH_URL=http://127.0.0.1:3100

# Where schema artifacts are stored. Required in production; development defaults to .local/artifacts.
# SKEMATRON_ARTIFACT_DIR=/var/lib/skematron/artifacts

# Integration tests only: a dedicated, disposable database. Tests create and drop their own
# skematron_test_* schemas and skematron_it_* databases on its server.
SKEMATRON_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/skematron_test
