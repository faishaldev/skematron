// Skematron's own metadata database. It changes only through migrations in prisma/migrations
// (`pnpm db:migrate` in development, `pnpm db:deploy` in production). These migrations must
// never be applied to a user's application database. See ai/rules/metadata.md.

generator client {
  provider            = "prisma-client"
  output              = "../apps/web/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// The self-hosted installation: a single row (id = 1) holding its one organization.
/// Inserting the row claims first-run setup.
model Installation {
  id             Int      @id @default(1)
  /// "pending" while setup runs, then "complete".
  status         String
  ownerEmail     String
  organizationId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("installation")
}

model Project {
  id             String          @id @default(uuid(7))
  organizationId String
  slug           String
  name           String
  /// Where the schema is written: "code" (a schema.prisma or the database itself) or
  /// "dashboard" (the schema editor). The editor works only for "dashboard".
  schemaSource   String          @default("code")
  createdById    String
  createdAt      DateTime        @default(now())
  environments   Environment[]
  versions       SchemaVersion[]
  migrations     Migration[]
  branches       Branch[]

  @@unique([organizationId, slug])
  @@map("project")
}

/// A database target. The connection URL is stored only encrypted (AES-256-GCM).
model Environment {
  id                   String   @id @default(uuid(7))
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name                 String
  engine               String
  connectionCiphertext String
  /// Redacted URL for display; never contains the password.
  connectionHint       String
  namespaces           String[]
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([projectId, name])
  @@map("environment")
}

/// An immutable schema version. The snapshot itself is an artifact keyed by `checksum`.
model SchemaVersion {
  id             String      @id @default(uuid(7))
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  number         Int
  checksum       String
  dialect        String
  formatVersion  Int
  sizeBytes      Int
  /// Provenance: environment id and name, server version, adapter.
  source         Json
  /// Objects the introspection reported but did not capture.
  unsupported    Json
  note           String?
  createdById    String
  createdAt      DateTime    @default(now())
  migrationsFrom Migration[] @relation("MigrationFrom")
  migrationsTo   Migration[] @relation("MigrationTo")
  branchesFrom   Branch[]    @relation("BranchBase")
  mergedBranch   Branch?     @relation("BranchMerged")

  @@unique([projectId, number])
  @@index([projectId, checksum])
  @@map("schema_version")
}

/// A proposed change to a project's schema, started from the latest version on main. People
/// change its head (schema editor or schema.prisma upload), test and review it through its
/// migration, then merge it (the head becomes the next version) or close it.
model Branch {
  id              String         @id @default(uuid(7))
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name            String
  /// "open", "merged" or "closed".
  status          String
  /// The main version the branch compares against; null when main had no versions yet.
  baseVersionId   String?
  baseVersion     SchemaVersion? @relation("BranchBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
  /// The branch's schema: a canonical snapshot, as PostgreSQL reported it after the last change.
  head            Json
  /// What was reported for the head but not captured, such as extensions.
  headUnsupported Json
  /// Where the head came from last: the editor, a schema.prisma upload or a database import.
  headSource      Json
  /// The version the branch became when it was merged.
  mergedVersionId String?        @unique
  mergedVersion   SchemaVersion? @relation("BranchMerged", fields: [mergedVersionId], references: [id], onDelete: Restrict)
  createdById     String
  /// Everyone who created, changed, rebased or tested the branch. None of them may review it.
  contributorIds  String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  closedAt        DateTime?
  migration       Migration?

  @@unique([projectId, name])
  @@map("branch")
}

/// The review of a branch: the change from its base to its head. Its content lives in
/// immutable revisions; only `status` changes, following the review workflow.
model Migration {
  id            String              @id @default(uuid(7))
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  number        Int
  title         String
  /// "draft", "in_review", "approved" or "rejected".
  status        String
  /// The branch this migration reviews.
  branchId      String?             @unique
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// The branch's base version; null when main had no versions.
  fromVersionId String?
  fromVersion   SchemaVersion?      @relation("MigrationFrom", fields: [fromVersionId], references: [id], onDelete: Restrict)
  /// The version the branch became when merged.
  toVersionId   String?
  toVersion     SchemaVersion?      @relation("MigrationTo", fields: [toVersionId], references: [id], onDelete: Restrict)
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  revisions     MigrationRevision[]
  reviews       MigrationReview[]

  @@unique([projectId, number])
  @@map("migration")
}

/// One state of a migration: answers, plan and script (artifacts), and the shadow
/// verification result. Never updated or deleted.
model MigrationRevision {
  id                 String            @id @default(uuid(7))
  migrationId        String
  migration          Migration         @relation(fields: [migrationId], references: [id], onDelete: Restrict)
  number             Int
  /// Answers to the planner's questions, keyed by question id.
  answers            Json
  /// Artifact keys of the plan (JSON) and the rendered SQL script.
  planChecksum       String
  scriptChecksum     String
  /// Artifact key of the snapshot this revision planned towards (the branch head when tested).
  toChecksum         String?
  /// Operation counts: total, safe, caution, destructive.
  summary            Json
  openQuestions      Int
  unsupportedChanges Int
  /// "passed", "failed" or "unavailable" (no shadow database).
  verification       String
  verificationDetail String?
  createdById        String
  createdAt          DateTime          @default(now())
  reviews            MigrationReview[]

  @@unique([migrationId, number])
  @@map("migration_revision")
}

/// A verdict on one exact revision. Never updated or deleted.
model MigrationReview {
  id                      String            @id @default(uuid(7))
  migrationId             String
  migration               Migration         @relation(fields: [migrationId], references: [id], onDelete: Restrict)
  revisionId              String
  revision                MigrationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  reviewerId              String
  /// "approved" or "rejected".
  verdict                 String
  comment                 String?
  acknowledgedDestructive Boolean           @default(false)
  createdAt               DateTime          @default(now())

  @@index([migrationId, createdAt])
  @@map("migration_review")
}

/// Privileged actions. Details never contain secrets.
model AuditEvent {
  id             String   @id @default(uuid(7))
  organizationId String
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  details        Json
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_event")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
